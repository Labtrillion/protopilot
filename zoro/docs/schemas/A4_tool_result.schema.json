{
  "$defs": {
    "DataQuality": {
      "enum": [
        "good",
        "uncertain",
        "bad"
      ],
      "title": "DataQuality",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "t_start_s": {
          "title": "T Start S",
          "type": "number"
        },
        "t_end_s": {
          "title": "T End S",
          "type": "number"
        }
      },
      "required": [
        "run_id",
        "sensor_id",
        "t_start_s",
        "t_end_s"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "ExperimentConditions": {
      "additionalProperties": false,
      "description": "비교 가능성 판단 키. 하나라도 다르면 동일 조건 A/B 비교가 아니다.",
      "properties": {
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "horizon_s": {
          "title": "Horizon S",
          "type": "number"
        },
        "simulator_version": {
          "title": "Simulator Version",
          "type": "string"
        },
        "disturbance_profile_id": {
          "title": "Disturbance Profile Id",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "시뮬레이터 시드. null = 미제공",
          "title": "Seed"
        },
        "initial_composition_sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "초기 조건에 쓴 조성 시료. null = 미지정",
          "title": "Initial Composition Sample Id"
        }
      },
      "required": [
        "snapshot_id",
        "horizon_s",
        "simulator_version",
        "disturbance_profile_id",
        "initial_composition_sample_id"
      ],
      "title": "ExperimentConditions",
      "type": "object"
    },
    "ImpactResult": {
      "additionalProperties": false,
      "description": "동은 모듈 출력: 한 run 의 후속 영향. 모두 가상 예측.",
      "properties": {
        "kind": {
          "const": "simulation_prediction",
          "default": "simulation_prediction",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "original_alarm_recovered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = 판단 불가",
          "title": "Original Alarm Recovered"
        },
        "recovery_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "run 시작 기준 [s]. null = 회복 안 됨/판단 불가",
          "title": "Recovery Time S"
        },
        "affected_equipment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Affected Equipment",
          "type": "array"
        },
        "affected_sensors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Affected Sensors",
          "type": "array"
        },
        "exceedances": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LimitExceedance"
          },
          "title": "Exceedances",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricValue"
          },
          "default": {},
          "title": "Metrics",
          "type": "object"
        },
        "evidence_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence Spans",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "벤치마크 점수(비용 USD/m³·정확도·게이트). 가상 예측"
        }
      },
      "required": [
        "run_id",
        "original_alarm_recovered",
        "recovery_time_s"
      ],
      "title": "ImpactResult",
      "type": "object"
    },
    "LimitExceedance": {
      "additionalProperties": false,
      "properties": {
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "equipment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equipment Id"
        },
        "limit_name": {
          "title": "Limit Name",
          "type": "string"
        },
        "limit_value": {
          "title": "Limit Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "first_exceeded_at_s": {
          "description": "run 시작 기준 [s]",
          "title": "First Exceeded At S",
          "type": "number"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "max_excess": {
          "description": "한계 대비 최대 초과량 (unit 과 동일 단위)",
          "title": "Max Excess",
          "type": "number"
        }
      },
      "required": [
        "sensor_id",
        "limit_name",
        "limit_value",
        "unit",
        "first_exceeded_at_s",
        "duration_s",
        "max_excess"
      ],
      "title": "LimitExceedance",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "better": {
          "anyOf": [
            {
              "enum": [
                "lower",
                "higher"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Better"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "실제 공정 측정값. 시뮬레이션 예측값은 절대 이 타입으로 만들지 않는다 (origin 고정).",
      "properties": {
        "origin": {
          "const": "plant_measurement",
          "default": "plant_measurement",
          "title": "Origin",
          "type": "string"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "측정값. null = 값 없음(결측/측정 실패). 0으로 대체 금지.",
          "title": "Value"
        },
        "unit": {
          "description": "단위 문자열 (예: kPa(g), degC, mol_frac, t/h)",
          "title": "Unit",
          "type": "string"
        },
        "measured_at_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "측정(시료 채취) 시뮬레이션 시각 [s]. null = 시각 모름 → 신선도 unknown",
          "title": "Measured At S"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "sample_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "시료/측정 식별자. 같은 시료 재전달 판별용. null = 미제공",
          "title": "Sample Id"
        }
      },
      "required": [
        "sensor_id",
        "value",
        "unit",
        "measured_at_s",
        "quality"
      ],
      "title": "Observation",
      "type": "object"
    },
    "RelationEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "source",
        "relation",
        "target"
      ],
      "title": "RelationEdge",
      "type": "object"
    },
    "RelationQueryPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "relation_query",
          "default": "relation_query",
          "title": "Kind",
          "type": "string"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelationEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "title": "RelationQueryPayload",
      "type": "object"
    },
    "RunScore": {
      "additionalProperties": false,
      "description": "run 하나의 벤치마크 점수. 시뮬레이션 run 이면 가상 예측.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "tripped": {
          "title": "Tripped",
          "type": "boolean"
        },
        "usd_per_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = 생산량 0 → 계산 불가",
          "title": "Usd Per M3"
        },
        "cost_usd": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "purge/product/power/steam/total, 평가 구간 누적",
          "title": "Cost Usd",
          "type": "object"
        },
        "product_m3": {
          "title": "Product M3",
          "type": "number"
        },
        "tracking_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Tracking Accuracy",
          "type": "number"
        },
        "per_variable_accuracy": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Per Variable Accuracy",
          "type": "object"
        },
        "in_threshold_fraction": {
          "description": "모든 추적 변수가 임계값 안인 시간 비율",
          "title": "In Threshold Fraction",
          "type": "number"
        },
        "time_to_stable_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "이후 끝까지 모두 임계값 안인 첫 시각(run 기준). null = 없음",
          "title": "Time To Stable S"
        },
        "final_window_inside": {
          "title": "Final Window Inside",
          "type": "boolean"
        },
        "quality_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = 품질 계측 없음",
          "title": "Quality Ok"
        },
        "failed_gates": {
          "description": "심슨 생산량 비교 전 자체 게이트 실패 목록",
          "items": {
            "type": "string"
          },
          "title": "Failed Gates",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "tripped",
        "usd_per_m3",
        "cost_usd",
        "product_m3",
        "tracking_accuracy",
        "per_variable_accuracy",
        "in_threshold_fraction",
        "time_to_stable_s",
        "final_window_inside",
        "quality_ok",
        "failed_gates"
      ],
      "title": "RunScore",
      "type": "object"
    },
    "SensorQueryPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sensor_query",
          "default": "sensor_query",
          "title": "Kind",
          "type": "string"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "unavailable_sensor_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unavailable Sensor Ids",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "SensorQueryPayload",
      "type": "object"
    },
    "SimulationPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "simulation",
          "default": "simulation",
          "title": "Kind",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/SimulationRun"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run"
      ],
      "title": "SimulationPayload",
      "type": "object"
    },
    "SimulationRun": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "simulation_prediction",
          "default": "simulation_prediction",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Case Id"
        },
        "conditions": {
          "$ref": "#/$defs/ExperimentConditions"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "aborted"
          ],
          "title": "Status",
          "type": "string"
        },
        "timeseries_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "센서 시계열 저장 위치. null = 없음",
          "title": "Timeseries Ref"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "run_id",
        "snapshot_id",
        "action_id",
        "case_id",
        "conditions",
        "status"
      ],
      "title": "SimulationRun",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "false 이면 반복을 종료하고 운영자 검토 요청",
          "title": "Recoverable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "recoverable"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tool_request_id": {
      "title": "Tool Request Id",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "aborted",
        "running"
      ],
      "title": "Status",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "relation_query": "#/$defs/RelationQueryPayload",
              "sensor_query": "#/$defs/SensorQueryPayload",
              "simulation": "#/$defs/SimulationPayload"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SensorQueryPayload"
            },
            {
              "$ref": "#/$defs/RelationQueryPayload"
            },
            {
              "$ref": "#/$defs/SimulationPayload"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "finished_sim_time_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "실제 공정 조회 완료 시각. 가상 실험은 공정 시간을 진행시키지 않으므로 null",
      "title": "Finished Sim Time S"
    },
    "is_virtual": {
      "description": "가짜 도구/가상 결과이면 true",
      "title": "Is Virtual",
      "type": "boolean"
    }
  },
  "required": [
    "tool_request_id",
    "tool_name",
    "status",
    "is_virtual"
  ],
  "title": "ToolResult",
  "type": "object"
}