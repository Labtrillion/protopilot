          "title": "Hi"
        },
        "lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "하한 경보 임계값. null = 하한 없음",
          "title": "Lo"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        },
        "source": {
          "description": "목표·임계값 출처",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "tag",
        "setpoint",
        "unit",
        "hi",
        "lo",
        "source"
