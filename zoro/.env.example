# fake = 가짜 클라이언트(연결 없이 흐름 검증), http = 실제 Zoro-1 서버 호출
ZORO_MODE=fake
# trida-stack `serve.py --mode decide` 서버 주소 (예: http://localhost:30001). /v1/systemone 으로 POST
ZORO_BASE_URL=
# 게이트웨이 앞단 인증이 필요할 때만. 코드/저장소에 넣지 말 것
ZORO_API_KEY=
ZORO_TIMEOUT_S=30
# false | true | auto  (공식 reasoning 옵션)
ZORO_REASONING=false
ZORO_MODEL_LABEL=trillionlabs/Zoro-1
