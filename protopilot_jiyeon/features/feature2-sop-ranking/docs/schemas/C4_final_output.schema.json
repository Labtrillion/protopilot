{
  "$defs": {
    "CaseSelection": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "continue",
            "select_case",
            "select_baseline",
            "none_acceptable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "baseline_run_id": {
          "title": "Baseline Run Id",
          "type": "string"
        },
        "selected_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Run Id"
        },
        "selected_action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Action Id"
        },
        "since_incumbent": {
          "description": "최선 case 이후 이기지 못한 case 수",
          "title": "Since Incumbent",
          "type": "integer"
        },
        "tested": {
          "title": "Tested",
          "type": "integer"
        },
        "remaining": {
          "title": "Remaining",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/SelectionStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "status",
        "reason",
        "baseline_run_id",
        "selected_run_id",
        "selected_action_id",
        "since_incumbent",
        "tested",
        "remaining",
        "steps"
      ],
      "title": "CaseSelection",
      "type": "object"
    },
    "ControllerStep": {
      "additionalProperties": false,
      "description": "Studio 제어 코드로 계산한 하위 루프 즉시 변화 (측정값이 아직 그대로라는 가정).",
      "properties": {
        "loop": {
          "title": "Loop",
          "type": "string"
        },
        "control": {
          "enum": [
            "P",
            "PI"
          ],
          "title": "Control",
          "type": "string"
        },
        "period_s": {
          "title": "Period S",
          "type": "integer"
        },
        "target": {
          "description": "SETPT(n) 또는 XMV(n)",
          "title": "Target",
          "type": "string"
        },
        "immediate_delta": {
          "title": "Immediate Delta",
          "type": "number"
        },
        "integral_per_run": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "오차가 유지될 때 실행 1회당 추가 변화. P 전용이면 null",
          "title": "Integral Per Run"
        },
        "value_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "XMV 의 현재 관측값. null = 미제공",
          "title": "Value Before"
        },
        "value_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value After"
        }
      },
      "required": [
        "loop",
        "control",
        "period_s",
        "target",
        "immediate_delta",
        "integral_per_run"
      ],
      "title": "ControllerStep",
      "type": "object"
    },
    "RationaleItem": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "basis": {
          "enum": [
            "observation",
            "policy",
            "experiment",
            "rag_evidence",
            "safety_check",
            "agent_state"
          ],
          "title": "Basis",
          "type": "string"
        },
        "refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "basis"
      ],
      "title": "RationaleItem",
      "type": "object"
    },
    "ResolvedSetpointChange": {
      "additionalProperties": false,
      "description": "시뮬레이터/감독기로 그대로 전달되는 변경 한 건.",
      "properties": {
        "setpoint_id": {
          "title": "Setpoint Id",
          "type": "string"
        },
        "scheme_index": {
          "title": "Scheme Index",
          "type": "integer"
        },
        "loop_id": {
          "title": "Loop Id",
          "type": "string"
        },
        "controlled_tag": {
          "title": "Controlled Tag",
          "type": "string"
        },
        "from_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "변경 전 값. null = 현재값 미제공",
          "title": "From Value"
        },
        "from_source": {
          "enum": [
            "active_setpoint",
            "unknown"
          ],
          "title": "From Source",
          "type": "string"
        },
        "target_value": {
          "title": "Target Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "apply_at_s": {
          "title": "Apply At S",
          "type": "number"
        },
        "ramp_rate_per_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ramp Rate Per H"
        },
        "allowed_min": {
          "title": "Allowed Min",
          "type": "number"
        },
        "allowed_max": {
          "title": "Allowed Max",
          "type": "number"
        },
        "controller_response": {
          "default": [],
          "description": "tep_control.cascade_response 계산. 현재값을 모르면 빈 목록",
          "items": {
            "$ref": "#/$defs/ControllerStep"
          },
          "title": "Controller Response",
          "type": "array"
        }
      },
      "required": [
        "setpoint_id",
        "scheme_index",
        "loop_id",
        "controlled_tag",
        "from_value",
        "from_source",
        "target_value",
        "unit",
        "apply_at_s",
        "ramp_rate_per_h",
        "allowed_min",
        "allowed_max"
      ],
      "title": "ResolvedSetpointChange",
      "type": "object"
    },
    "RevertRule": {
      "additionalProperties": false,
      "description": "원복(또는 hold 복귀) 조건. 감독기가 평가한다.",
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "판정 계측. null = 이벤트형(보호 작동 등)",
          "title": "Signal"
        },
        "op": {
          "enum": [
            ">=",
            "<=",
            ">",
            "<",
            "event"
          ],
          "title": "Op",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "rule_id",
        "description",
        "op"
      ],
      "title": "RevertRule",
      "type": "object"
    },
    "SelectionStep": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action Id"
        },
        "beats_baseline": {
          "title": "Beats Baseline",
          "type": "boolean"
        },
        "vs_baseline": {
          "title": "Vs Baseline",
          "type": "string"
        },
        "beats_incumbent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = 아직 최선 case 없음",
          "title": "Beats Incumbent"
        },
        "vs_incumbent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vs Incumbent"
        },
        "incumbent_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Incumbent After"
        }
      },
      "required": [
        "run_id",
        "action_id",
        "beats_baseline",
        "vs_baseline",
        "beats_incumbent",
        "vs_incumbent",
        "incumbent_after"
      ],
      "title": "SelectionStep",
      "type": "object"
    },
    "SetpointCommand": {
      "additionalProperties": false,
      "description": "감독기·시뮬레이터 어댑터가 적용할 상위 목표 명령 (STUDIO.md 'Zoro 출력' 계약).\n\n내용은 모두 등록 case 에서 온다. 모델이 만든 값은 없다. 적용 여부는 감독기가 결정한다.",
      "properties": {
        "decision": {
          "enum": [
            "hold",
            "propose_setpoint"
          ],
          "title": "Decision",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = 등록 hold case 없음(현재 목표 유지)",
          "title": "Case Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "setpoint_changes": {
          "description": "hold 이면 빈 목록",
          "items": {
            "$ref": "#/$defs/ResolvedSetpointChange"
          },
          "title": "Setpoint Changes",
          "type": "array"
        },
        "sop_refs": {
          "items": {
            "$ref": "#/$defs/SopRef"
          },
          "title": "Sop Refs",
          "type": "array"
        },
        "expected_cost_direction": {
          "additionalProperties": {
            "enum": [
              "increase",
              "decrease",
              "no_change",
              "unknown"
            ],
            "type": "string"
          },
          "description": "카탈로그 사전 가설(case 등록자 작성). 시뮬레이션·실측 결과 아님",
          "propertyNames": {
            "enum": [
              "purge",
              "product",
              "compressor",
              "steam"
            ]
          },
          "title": "Expected Cost Direction",
          "type": "object"
        },
        "expected_direction_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Direction Basis"
        },
        "simulated_effects": {
          "description": "기준 대비 가상 예측 차이",
          "items": {
            "$ref": "#/$defs/SimulatedEffect"
          },
          "title": "Simulated Effects",
          "type": "array"
        },
        "actual_effects": {
          "default": null,
          "description": "실제 적용 후 평가기가 기록. 에이전트는 채우지 않음",
          "title": "Actual Effects",
          "type": "null"
        },
        "watch_signals": {
          "items": {
            "type": "string"
          },
          "title": "Watch Signals",
          "type": "array"
        },
        "issued_sim_time_s": {
          "title": "Issued Sim Time S",
          "type": "number"
        },
        "review_at_sim_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "재검토 시각 [s]. null = 정해진 재검토 없음",
          "title": "Review At Sim Time S"
        },
        "revert_rules": {
          "items": {
            "$ref": "#/$defs/RevertRule"
          },
          "title": "Revert Rules",
          "type": "array"
        },
        "values_status": {
          "description": "example = 예시 설정값(검증 기준 아님)",
          "enum": [
            "example",
            "agreed"
          ],
          "title": "Values Status",
          "type": "string"
        },
        "requires_supervisor_approval": {
          "const": true,
          "default": true,
          "title": "Requires Supervisor Approval",
          "type": "boolean"
        }
      },
      "required": [
        "decision",
        "case_id",
        "reason",
        "setpoint_changes",
        "sop_refs",
        "expected_cost_direction",
        "expected_direction_basis",
        "simulated_effects",
        "watch_signals",
        "issued_sim_time_s",
        "review_at_sim_time_s",
        "revert_rules",
        "values_status"
      ],
      "title": "SetpointCommand",
      "type": "object"
    },
    "SimulatedEffect": {
      "additionalProperties": false,
      "description": "기준(hold) 대비 가상 예측 차이. 실제 절감액이 아님.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "delta": {
          "description": "후보 - 기준",
          "title": "Delta",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "baseline_run_id": {
          "title": "Baseline Run Id",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "delta",
        "unit",
        "run_id",
        "baseline_run_id"
      ],
      "title": "SimulatedEffect",
      "type": "object"
    },
    "SopRef": {
      "additionalProperties": false,
      "properties": {
        "sop_id": {
          "title": "Sop Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "sop_id",
        "version",
        "step_id"
      ],
      "title": "SopRef",
      "type": "object"
    },
    "TerminationReason": {
      "enum": [
        "recommendation_ready",
        "human_review_selected",
        "limit_reached",
        "unrecoverable_tool_error",
        "no_valid_options",
        "model_response_invalid",
        "model_call_failed"
      ],
      "title": "TerminationReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "state_version": {
      "title": "State Version",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "recommendation",
        "human_review"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "termination_reason": {
      "$ref": "#/$defs/TerminationReason"
    },
    "recommended_action_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "null = 권고 없음(운영자 검토)",
      "title": "Recommended Action Id"
    },
    "setpoint_command": {
      "$ref": "#/$defs/SetpointCommand",
      "description": "시뮬레이터/감독기로 넘길 hold 또는 propose_setpoint"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "rationale": {
      "items": {
        "$ref": "#/$defs/RationaleItem"
      },
      "title": "Rationale",
      "type": "array"
    },
    "rationale_note": {
      "default": "근거는 에이전트가 상태·정책·실험 결과로 구성한 것이며 모델이 생성한 설명이 아님",
      "title": "Rationale Note",
      "type": "string"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "compared_run_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Compared Run Ids",
      "type": "array"
    },
    "case_selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "심슨(hold) 대비 case 탐색 기록과 종료 판정. 가상 예측 기반"
    },
    "selection_distribution": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "마지막 결정의 행동 선택 분포. 안전/회복 확률 아님",
      "title": "Selection Distribution"
    },
    "model_client_kind": {
      "anyOf": [
        {
          "enum": [
            "real",
            "fake"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Client Kind"
    },
    "tools_virtual": {
      "title": "Tools Virtual",
      "type": "boolean"
    },
    "simulation_results_are_predictions": {
      "const": true,
      "default": true,
      "title": "Simulation Results Are Predictions",
      "type": "boolean"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "state_version",
    "outcome",
    "termination_reason",
    "recommended_action_id",
    "setpoint_command",
    "summary",
    "rationale",
    "uncertainties",
    "model_client_kind",
    "tools_virtual",
    "disclaimer"
  ],
  "title": "FinalOutput",
  "type": "object"
}